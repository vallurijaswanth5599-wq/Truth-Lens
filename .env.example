# VeriTrust Deployment Environment Variables

# External AI APIs (Required for full verification features)
GEMINI_API_KEY=AIzaSy-YOUR_KEY_HERE
TAVILY_API_KEY=tvly-YOUR_KEY_HERE

# Backend Configuration
SECRET_KEY=your-production-secret-key-change-me
DATABASE_URL=sqlite:///./veritrust.db
# For Vercel production persistence, use PostgreSQL (e.g. Supabase, Neon):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional Integrations
REDIS_URL=redis://localhost:6379/0
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend Configuration (Vite)
VITE_API_URL=/api/v1
VITE_SERVER_URL=
